// Pide un numero binario y le suma uno con una maquina
machine Incrementar {
    start derecha
    accept fin
    state derecha {
        0 -> 0, R, derecha
        1 -> 1, R, derecha
        blank -> blank, L, suma
    }
    state suma {
        1 -> 0, L, suma
        0 -> 1, S, fin
        blank -> 1, S, fin
    }
}

print("Escribe un numero binario:");
string b = input();
if (run Incrementar(b, 200)) {
    print(b + " + 1 = " + output Incrementar(b, 200));
} else {
    print("No es un numero binario");
}
